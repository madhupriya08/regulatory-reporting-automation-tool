# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Local databases (rebuildable from CSVs via build_database.py)
*.db
*.sqlite
*.sqlite3

# Query outputs (regenerated by run_queries.py)
output/*.csv

# Secrets. Snowflake credentials come from environment variables ONLY.
.env
*.env
secrets.toml
.streamlit/secrets.toml

# IDE. Run configurations ARE committed - they are the point of checking these
# folders in at all, and they let anyone open the project and hit Run. Everything
# else in .idea/ and .vscode/ is per-user state (window layout, local interpreter
# paths, caches) that would produce a churning diff on every commit.
.idea/*
!.idea/runConfigurations/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json

# OS noise
.DS_Store
